{
  "openapi": "3.1.0",
  "info": {
    "title": "SmartGN - IAM Service",
    "description": "Verified-purchase account provisioning, password activation and recovery, current JWT sessions, profiles and meter-specific delegations. Global roles: USER and SUPERADMIN. Billing owns subscriptions.",
    "version": "v1"
  },
  "servers": [
    {
      "url": "http://localhost:8080",
      "description": "Local Docker endpoint"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "tags": [
    {
      "name": "Profiles",
      "description": "Profile of the authenticated user"
    },
    {
      "name": "Authentication",
      "description": "Authentication and password recovery"
    }
  ],
  "paths": {
    "/api/v1/subusers/{subuserId}/grants": {
      "put": {
        "tags": [
          "Activation and delegated access"
        ],
        "summary": "Replace one meter's function grants, preserving other meters",
        "operationId": "grants",
        "parameters": [
          {
            "name": "subuserId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Grants"
              }
            }
          },
          "required": true
        },
        "responses": {
          "204": {
            "description": "No Content"
          }
        }
      }
    },
    "/api/v1/profiles/{profileId}": {
      "get": {
        "tags": [
          "Profiles"
        ],
        "summary": "Get a profile by id",
        "description": "Only the profile owner or a SUPERADMIN can read it.",
        "operationId": "getById",
        "parameters": [
          {
            "name": "profileId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Profile found",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ProfileResource"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid token",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ProfileResource"
                }
              }
            }
          },
          "403": {
            "description": "The profile belongs to another account",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ProfileResource"
                }
              }
            }
          },
          "404": {
            "description": "Profile not found",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ProfileResource"
                }
              }
            }
          }
        }
      },
      "put": {
        "tags": [
          "Profiles"
        ],
        "summary": "Update my profile",
        "description": "Replaces the profile data. Only the owner can modify it.",
        "operationId": "update",
        "parameters": [
          {
            "name": "profileId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateProfileResource"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Profile updated",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ProfileResource"
                }
              }
            }
          },
          "400": {
            "description": "Invalid data",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ProfileResource"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid token",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ProfileResource"
                }
              }
            }
          },
          "403": {
            "description": "The profile belongs to another account",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ProfileResource"
                }
              }
            }
          },
          "404": {
            "description": "Profile not found",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ProfileResource"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/profiles/me": {
      "get": {
        "tags": [
          "Profiles"
        ],
        "summary": "Get my profile",
        "description": "Returns the profile of the authenticated account.",
        "operationId": "getMine",
        "responses": {
          "200": {
            "description": "Profile found",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ProfileResource"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid token",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ProfileResource"
                }
              }
            }
          },
          "404": {
            "description": "The account does not have a profile yet",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ProfileResource"
                }
              }
            }
          }
        }
      },
      "put": {
        "tags": [
          "Profiles"
        ],
        "operationId": "updateMine",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateProfileResource"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ProfileResource"
                }
              }
            }
          }
        }
      }
    },
    "/internal/v1/sessions/introspect": {
      "post": {
        "tags": [
          "Activation and delegated access"
        ],
        "summary": "Check current account state and session version",
        "operationId": "introspect",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Session"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/Account"
                }
              }
            }
          }
        },
        "security": [
          {
            "serviceAuth": []
          }
        ]
      }
    },
    "/internal/v1/authorizations/check": {
      "post": {
        "tags": [
          "Activation and delegated access"
        ],
        "summary": "Check a current meter/function grant; entitlement checked separately when required",
        "operationId": "check",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Check"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "boolean"
                  }
                }
              }
            }
          }
        },
        "security": [
          {
            "serviceAuth": []
          }
        ]
      }
    },
    "/internal/v1/accounts/purchase-confirmations": {
      "post": {
        "tags": [
          "Activation and delegated access"
        ],
        "summary": "Provision an account after a verified initial purchase; controlled service input",
        "operationId": "provision",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ConfirmedPurchase"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/Account"
                }
              }
            }
          }
        },
        "security": [
          {
            "serviceAuth": []
          }
        ]
      }
    },
    "/api/v1/subusers": {
      "get": {
        "tags": [
          "Activation and delegated access"
        ],
        "summary": "List the principal account's subusers",
        "operationId": "subusers",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Account"
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "Activation and delegated access"
        ],
        "summary": "Create a delegated USER identity without initial permissions",
        "operationId": "subuser",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Subuser"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/Account"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/profiles": {
      "post": {
        "tags": [
          "Profiles"
        ],
        "summary": "Create my profile",
        "description": "Creates the profile of the authenticated account. Each account has a single profile.",
        "operationId": "create",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateProfileResource"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Profile created",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ProfileResource"
                }
              }
            }
          },
          "400": {
            "description": "Invalid data",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ProfileResource"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid token",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ProfileResource"
                }
              }
            }
          },
          "409": {
            "description": "The account already has a profile",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ProfileResource"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/sign-in": {
      "post": {
        "tags": [
          "Authentication"
        ],
        "summary": "Sign in",
        "description": "Validates the credentials and returns a signed JWT with the claims accountId, email, role, accountKind and sessionVersion.",
        "operationId": "signIn",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SignInResource"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Authentication successful",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/AuthenticatedAccountResource"
                }
              }
            }
          },
          "400": {
            "description": "Invalid data",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/AuthenticatedAccountResource"
                }
              }
            }
          },
          "401": {
            "description": "Invalid email or password",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/AuthenticatedAccountResource"
                }
              }
            }
          }
        },
        "security": []
      }
    },
    "/api/v1/auth/reset-password": {
      "post": {
        "tags": [
          "Authentication"
        ],
        "summary": "Reset the password",
        "description": "Changes the password using the token from the recovery link. The token is single-use and expires.",
        "operationId": "resetPassword",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ResetPasswordResource"
              }
            }
          },
          "required": true
        },
        "responses": {
          "204": {
            "description": "Password updated"
          },
          "400": {
            "description": "Invalid data, or token invalid, expired or already used"
          }
        },
        "security": []
      }
    },
    "/api/v1/auth/forgot-password": {
      "post": {
        "tags": [
          "Authentication"
        ],
        "summary": "Request password recovery",
        "description": "Requests a temporary reset link for a registered email. Delivery requires an configured notification delivery adapter. The response is the same whether or not the account exists.",
        "operationId": "forgotPassword",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ForgotPasswordResource"
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "description": "Request received",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/MessageResource"
                }
              }
            }
          },
          "400": {
            "description": "Email with invalid format",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/MessageResource"
                }
              }
            }
          }
        },
        "security": []
      }
    },
    "/api/v1/auth/change-password": {
      "post": {
        "tags": [
          "Activation and delegated access"
        ],
        "summary": "Change the current password and invalidate existing sessions",
        "operationId": "change",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Change"
              }
            }
          },
          "required": true
        },
        "responses": {
          "204": {
            "description": "No Content"
          }
        }
      }
    },
    "/api/v1/auth/activate-password": {
      "post": {
        "tags": [
          "Activation and delegated access"
        ],
        "summary": "Activate a pending principal or delegated account with a single-use token",
        "operationId": "activate",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Activation"
              }
            }
          },
          "required": true
        },
        "responses": {
          "204": {
            "description": "No Content"
          }
        },
        "security": []
      }
    },
    "/internal/v1/accounts/{id}": {
      "get": {
        "tags": [
          "Activation and delegated access"
        ],
        "operationId": "context",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/Account"
                }
              }
            }
          }
        },
        "security": [
          {
            "serviceAuth": []
          }
        ]
      }
    },
    "/internal/v1/accounts/{id}/grants": {
      "get": {
        "tags": [
          "Activation and delegated access"
        ],
        "operationId": "meterGrants",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "uniqueItems": true
                  }
                }
              }
            }
          }
        },
        "security": [
          {
            "serviceAuth": []
          }
        ]
      }
    },
    "/api/v1/subusers/{subuserId}/grants/{meterId}": {
      "get": {
        "tags": [
          "Activation and delegated access"
        ],
        "summary": "Get current function grants on a meter",
        "operationId": "grants_1",
        "parameters": [
          {
            "name": "subuserId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "meterId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "uniqueItems": true
                }
              }
            }
          }
        }
      },
      "delete": {
        "tags": [
          "Activation and delegated access"
        ],
        "summary": "Revoke all grants on one meter",
        "operationId": "revoke",
        "parameters": [
          {
            "name": "subuserId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "meterId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "No Content"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Grants": {
        "type": "object",
        "properties": {
          "meterId": {
            "type": "string",
            "format": "uuid"
          },
          "permissions": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          }
        },
        "required": [
          "meterId",
          "permissions"
        ]
      },
      "UpdateProfileResource": {
        "type": "object",
        "description": "Full replacement of the profile: if phone or address are not sent, they are cleared.",
        "properties": {
          "firstName": {
            "type": "string",
            "example": "Ana",
            "maxLength": 100,
            "minLength": 0
          },
          "lastName": {
            "type": "string",
            "example": "Perez",
            "maxLength": 100,
            "minLength": 0
          },
          "phone": {
            "type": "string",
            "example": 987654321,
            "pattern": "^\\+?[0-9 ()-]{7,20}$"
          },
          "address": {
            "type": "string",
            "example": 1234,
            "maxLength": 255,
            "minLength": 0
          }
        },
        "required": [
          "firstName",
          "lastName"
        ]
      },
      "ProfileResource": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "accountId": {
            "type": "string",
            "format": "uuid"
          },
          "firstName": {
            "type": "string"
          },
          "lastName": {
            "type": "string"
          },
          "phone": {
            "type": "string"
          },
          "address": {
            "type": "string"
          }
        }
      },
      "Session": {
        "type": "object",
        "properties": {
          "token": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "token"
        ]
      },
      "Account": {
        "type": "object",
        "properties": {
          "accountId": {
            "type": "string",
            "format": "uuid"
          },
          "email": {
            "type": "string"
          },
          "role": {
            "type": "string"
          },
          "accountKind": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "sessionVersion": {
            "type": "integer",
            "format": "int64"
          },
          "principalAccountId": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "Check": {
        "type": "object",
        "properties": {
          "accountId": {
            "type": "string",
            "format": "uuid"
          },
          "meterId": {
            "type": "string",
            "format": "uuid"
          },
          "function": {
            "type": "string",
            "minLength": 1
          },
          "requiresPro": {
            "type": "boolean"
          }
        },
        "required": [
          "accountId",
          "function",
          "meterId"
        ]
      },
      "ConfirmedPurchase": {
        "type": "object",
        "properties": {
          "eventId": {
            "type": "string",
            "format": "uuid"
          },
          "purchaseOrderId": {
            "type": "string",
            "format": "uuid"
          },
          "email": {
            "type": "string",
            "maxLength": 254,
            "minLength": 0
          },
          "firstName": {
            "type": "string",
            "maxLength": 100,
            "minLength": 0
          },
          "lastName": {
            "type": "string",
            "maxLength": 100,
            "minLength": 0
          },
          "confirmed": {
            "type": "boolean"
          }
        },
        "required": [
          "email",
          "eventId",
          "firstName",
          "lastName",
          "purchaseOrderId"
        ]
      },
      "Subuser": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "maxLength": 254,
            "minLength": 0
          },
          "firstName": {
            "type": "string",
            "maxLength": 100,
            "minLength": 0
          },
          "lastName": {
            "type": "string",
            "maxLength": 100,
            "minLength": 0
          }
        },
        "required": [
          "email",
          "firstName",
          "lastName"
        ]
      },
      "CreateProfileResource": {
        "type": "object",
        "properties": {
          "firstName": {
            "type": "string",
            "example": "Ana",
            "maxLength": 100,
            "minLength": 0
          },
          "lastName": {
            "type": "string",
            "example": "Perez",
            "maxLength": 100,
            "minLength": 0
          },
          "phone": {
            "type": "string",
            "description": "Optional. 7 to 20 characters: digits, spaces, parentheses, hyphens and an optional leading +",
            "example": 987654321,
            "pattern": "^\\+?[0-9 ()-]{7,20}$"
          },
          "address": {
            "type": "string",
            "description": "Optional",
            "example": 1234,
            "maxLength": 255,
            "minLength": 0
          }
        },
        "required": [
          "firstName",
          "lastName"
        ]
      },
      "SignInResource": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "user@example.test",
            "maxLength": 254,
            "minLength": 0
          },
          "password": {
            "type": "string",
            "example": "Secret123",
            "maxLength": 72,
            "minLength": 0
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "AuthenticatedAccountResource": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "email": {
            "type": "string"
          },
          "role": {
            "type": "string",
            "enum": [
              "USER",
              "SUPERADMIN"
            ]
          },
          "accountKind": {
            "type": "string"
          },
          "token": {
            "type": "string"
          }
        }
      },
      "ResetPasswordResource": {
        "type": "object",
        "properties": {
          "token": {
            "type": "string",
            "description": "Token received in the recovery link",
            "maxLength": 200,
            "minLength": 0
          },
          "newPassword": {
            "type": "string",
            "description": "Between 8 and 72 characters",
            "example": "NewPassword123",
            "maxLength": 72,
            "minLength": 8
          }
        },
        "required": [
          "newPassword",
          "token"
        ]
      },
      "ForgotPasswordResource": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "user@example.test",
            "maxLength": 254,
            "minLength": 0
          }
        },
        "required": [
          "email"
        ]
      },
      "MessageResource": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string"
          }
        }
      },
      "Change": {
        "type": "object",
        "properties": {
          "currentPassword": {
            "type": "string",
            "minLength": 1
          },
          "newPassword": {
            "type": "string",
            "maxLength": 72,
            "minLength": 8
          }
        },
        "required": [
          "currentPassword",
          "newPassword"
        ]
      },
      "Activation": {
        "type": "object",
        "properties": {
          "activationToken": {
            "type": "string",
            "minLength": 1
          },
          "newPassword": {
            "type": "string",
            "maxLength": 72,
            "minLength": 8
          }
        },
        "required": [
          "activationToken",
          "newPassword"
        ]
      }
    },
    "securitySchemes": {
      "serviceAuth": {
        "type": "http",
        "description": "Private service credential, independent of user JWTs. Never expose internal paths through a public gateway.",
        "scheme": "bearer"
      },
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  }
}
