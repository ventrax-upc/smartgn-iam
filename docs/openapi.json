          "401": {
            "description": "Missing or invalid private service credential."
          }
        },
        "security": [
          {
            "serviceAuth": []
          }
        ]
      }
    },
    "/internal/v1/accounts/{id}/grants": {
      "get": {
        "tags": [
          "Internal identity"
        ],
        "summary": "Get active delegated meter grants",
