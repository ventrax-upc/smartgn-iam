        "operationId": "revoke",
        "parameters": [
          {
            "name": "subuserId",
            "in": "path",
            "description": "Resource UUID. Possession of an identifier does not replace authorization.",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "meterId",
            "in": "path",
            "description": "Resource UUID. Possession of an identifier does not replace authorization.",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
