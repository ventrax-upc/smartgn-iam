{
  "openapi": "3.1.0",
  "info": {
    "title": "SmartGN - IAM",
    "description": "Identity, account activation and recovery, current sessions, profiles and delegated access by meter and function. Owns an independent PostgreSQL database and integrates through authenticated HTTP and durable events. Local fixtures do not establish productive external integration.",
    "license": {
      "name": "MIT"
    },
    "version": "v1"
  },
  "servers": [
    {
      "url": "http://localhost:18080",
      "description": "Generated server url"
    }
  ],
  "tags": [
    {
      "name": "Authentication",
      "description": "Sign-in, activation, password recovery and current-session management."
    },
    {
      "name": "Profiles",
      "description": "Owned account profile data."
    },
    {
      "name": "Delegated access",
      "description": "Principal-owned delegated USER accounts and independent per-meter function grants."
    },
    {
      "name": "Internal identity",
      "description": "Private identity, session and authorization contracts."
    }
  ],
  "paths": {
    "/api/v1/subusers/{subuserId}/grants": {
      "put": {
        "tags": [
          "Delegated access"
        ],
        "summary": "Replace one meter's function grants",
        "description": "Requires the owning principal USER and verified meter ownership. Replaces grants for this meter while preserving other meters. Authentication: current IAM JWT; roles are USER and SUPERADMIN.",
        "operationId": "grants",
        "parameters": [
          {
            "name": "subuserId",
            "in": "path",
            "description": "Resource UUID. Possession of an identifier does not replace authorization.",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Grants"
              }
            }
          },
          "required": true
        },
        "responses": {
          "204": {
            "description": "Operation completed without a response body."
          },
          "401": {
            "description": "Missing, expired, revoked or invalid IAM session."
          },
          "403": {
            "description": "The current account does not have the required role, ownership or meter/function permission."
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    },
    "/api/v1/profiles/{profileId}": {
      "get": {
        "tags": [
          "Profiles"
        ],
        "summary": "Get an authorized profile",
        "description": "Allows the profile owner or SUPERADMIN to read the requested profile. Authentication: current IAM JWT; roles are USER and SUPERADMIN.",
        "operationId": "getById",
        "parameters": [
          {
            "name": "profileId",
            "in": "path",
            "description": "Resource UUID. Possession of an identifier does not replace authorization.",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Operation completed successfully.",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ProfileResource"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid token",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ProfileResource"
                }
              }
            }
          },
          "403": {
            "description": "The profile belongs to another account",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ProfileResource"
                }
              }
            }
          },
          "404": {
            "description": "Profile not found",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ProfileResource"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      },
      "put": {
        "tags": [
          "Profiles"
        ],
        "summary": "Update an owned profile",
        "description": "Allows only the profile owner to update editable fields. SUPERADMIN does not acquire ownership by role alone. Authentication: current IAM JWT; roles are USER and SUPERADMIN.",
        "operationId": "update",
        "parameters": [
          {
            "name": "profileId",
            "in": "path",
            "description": "Resource UUID. Possession of an identifier does not replace authorization.",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateProfileResource"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Operation completed successfully.",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ProfileResource"
                }
              }
            }
          },
          "400": {
            "description": "Invalid data",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ProfileResource"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid token",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ProfileResource"
                }
              }
            }
          },
          "403": {
            "description": "The profile belongs to another account",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ProfileResource"
                }
              }
            }
          },
          "404": {
            "description": "Profile not found",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ProfileResource"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    },
    "/api/v1/profiles/me": {
      "get": {
        "tags": [
          "Profiles"
        ],
        "summary": "Get the current account profile",
        "description": "Returns only the profile associated with the authenticated account. Authentication: current IAM JWT; roles are USER and SUPERADMIN.",
        "operationId": "getMine",
        "responses": {
          "200": {
            "description": "Operation completed successfully.",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ProfileResource"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid token",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ProfileResource"
                }
              }
            }
          },
          "404": {
            "description": "The account does not have a profile yet",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ProfileResource"
                }
              }
            }
          },
          "403": {
            "description": "The current account does not have the required role, ownership or meter/function permission."
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      },
      "put": {
        "tags": [
          "Profiles"
        ],
        "summary": "Update the current account profile",
        "description": "Updates the authenticated account's editable profile fields. Account identity and role cannot be changed here. Authentication: current IAM JWT; roles are USER and SUPERADMIN.",
        "operationId": "updateMine",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateProfileResource"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Operation completed successfully.",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ProfileResource"
                }
              }
            }
          },
          "401": {
            "description": "Missing, expired, revoked or invalid IAM session."
          },
          "403": {
            "description": "The current account does not have the required role, ownership or meter/function permission."
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    },
    "/internal/v1/sessions/introspect": {
      "post": {
        "tags": [
          "Internal identity"
        ],
        "summary": "Validate a current user session",
        "description": "Verifies JWT cryptography, issuer, audience, expiry, account status and session version. Returns account context without credentials. Authentication: private service credential; user JWTs are not accepted. Internal routes must remain outside public gateway routing.",
        "operationId": "introspect",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Session"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Operation completed successfully.",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/Account"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid private service credential."
          }
        },
        "security": [
          {
            "serviceAuth": []
          }
        ]
      }
    },
    "/internal/v1/authorizations/check": {
      "post": {
        "tags": [
          "Internal identity"
        ],
        "summary": "Check a meter and function authorization",
        "description": "Checks current ownership and delegated grants. When requiresPro is true, confirms the principal's entitlement with Billing. Authentication: private service credential; user JWTs are not accepted. Internal routes must remain outside public gateway routing.",
        "operationId": "check",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Check"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Operation completed successfully.",
            "content": {
              "*/*": {
                "schema": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "boolean"
                  }
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid private service credential."
          }
        },
        "security": [
          {
            "serviceAuth": []
          }
        ]
      }
    },
    "/internal/v1/accounts/purchase-confirmations": {
      "post": {
        "tags": [
          "Internal identity"
        ],
        "summary": "Apply a verified purchase confirmation",
        "description": "Provisions a pending principal from trusted purchase evidence. Repeated receipts are idempotent; contradictory identities are rejected. Authentication: private service credential; user JWTs are not accepted. Internal routes must remain outside public gateway routing.",
        "operationId": "provision",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ConfirmedPurchase"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Operation completed successfully.",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/Account"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid private service credential."
          }
        },
        "security": [
          {
            "serviceAuth": []
          }
        ]
      }
    },
    "/api/v1/subusers": {
      "get": {
        "tags": [
          "Delegated access"
        ],
        "summary": "List delegated accounts",
        "description": "Requires a principal USER and returns only its delegated accounts. Authentication: current IAM JWT; roles are USER and SUPERADMIN.",
        "operationId": "subusers",
        "responses": {
          "200": {
            "description": "Operation completed successfully.",
            "content": {
              "*/*": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Account"
                  }
                }
              }
            }
          },
          "401": {
            "description": "Missing, expired, revoked or invalid IAM session."
          },
          "403": {
            "description": "The current account does not have the required role, ownership or meter/function permission."
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      },
      "post": {
        "tags": [
          "Delegated access"
        ],
        "summary": "Create a delegated account",
        "description": "Requires a principal USER. Creates a pending USER account without initial meter grants or financial permissions. Authentication: current IAM JWT; roles are USER and SUPERADMIN.",
        "operationId": "subuser",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Subuser"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Resource created.",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/Account"
                }
              }
            }
          },
          "401": {
            "description": "Missing, expired, revoked or invalid IAM session."
          },
          "403": {
            "description": "The current account does not have the required role, ownership or meter/function permission."
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    },
    "/api/v1/profiles": {
      "post": {
        "tags": [
          "Profiles"
        ],
        "summary": "Create the current account profile",
        "description": "Creates a profile only when the authenticated account has none. Duplicate profiles are rejected. Authentication: current IAM JWT; roles are USER and SUPERADMIN.",
        "operationId": "create",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateProfileResource"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Resource created.",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ProfileResource"
                }
              }
            }
          },
          "400": {
            "description": "Invalid data",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ProfileResource"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid token",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ProfileResource"
                }
              }
            }
          },
          "409": {
            "description": "The account already has a profile",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ProfileResource"
                }
              }
            }
          },
          "403": {
            "description": "The current account does not have the required role, ownership or meter/function permission."
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    },
    "/api/v1/auth/sign-in": {
      "post": {
        "tags": [
          "Authentication"
        ],
        "summary": "Sign in to an active account",
        "description": "Validates credentials and returns a current IAM JWT. Inactive accounts and invalid credentials are rejected. Authentication: no user JWT required; the operation-specific token or checkout secret still applies when specified.",
        "operationId": "signIn",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SignInResource"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Operation completed successfully.",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/AuthenticatedAccountResource"
                }
              }
            }
          },
          "400": {
            "description": "Invalid data",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/AuthenticatedAccountResource"
                }
              }
            }
          },
          "401": {
            "description": "Invalid email or password",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/AuthenticatedAccountResource"
                }
              }
            }
          }
        },
        "security": []
      }
    },
    "/api/v1/auth/reset-password": {
      "post": {
        "tags": [
          "Authentication"
        ],
        "summary": "Reset an account password",
        "description": "Consumes a recovery-purpose token once and invalidates existing sessions. Activation tokens cannot be used for recovery. Authentication: no user JWT required; the operation-specific token or checkout secret still applies when specified.",
        "operationId": "resetPassword",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ResetPasswordResource"
              }
            }
          },
          "required": true
        },
        "responses": {
          "204": {
            "description": "Operation completed without a response body."
          },
          "400": {
            "description": "Invalid data, or token invalid, expired or already used"
          }
        },
        "security": []
      }
    },
    "/api/v1/auth/forgot-password": {
      "post": {
        "tags": [
          "Authentication"
        ],
        "summary": "Request password recovery",
        "description": "Returns the same accepted response for known and unknown email addresses. Eligible accounts receive a recovery message through the configured delivery adapter. Authentication: no user JWT required; the operation-specific token or checkout secret still applies when specified.",
        "operationId": "forgotPassword",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ForgotPasswordResource"
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "description": "Request accepted; asynchronous work or delivery may still be pending.",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/MessageResource"
                }
              }
            }
          },
          "400": {
            "description": "Email with invalid format",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/MessageResource"
                }
              }
            }
          }
        },
        "security": []
      }
    },
    "/api/v1/auth/change-password": {
      "post": {
        "tags": [
          "Authentication"
        ],
        "summary": "Change the current password",
        "description": "Requires the current password and authenticated account. Invalidates previously issued sessions after a successful change. Authentication: current IAM JWT; roles are USER and SUPERADMIN.",
        "operationId": "change",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Change"
              }
            }
          },
          "required": true
        },
        "responses": {
          "204": {
            "description": "Operation completed without a response body."
          },
          "401": {
            "description": "Missing, expired, revoked or invalid IAM session."
          },
          "403": {
            "description": "The current account does not have the required role, ownership or meter/function permission."
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    },
    "/api/v1/auth/activate-password": {
      "post": {
        "tags": [
          "Authentication"
        ],
        "summary": "Activate an account password",
        "description": "Consumes a single-use activation token and activates the pending principal or delegated account. Authentication: no user JWT required; the operation-specific token or checkout secret still applies when specified.",
        "operationId": "activate",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Activation"
              }
            }
          },
          "required": true
        },
        "responses": {
          "204": {
            "description": "Operation completed without a response body."
          }
        },
        "security": []
      }
    },
