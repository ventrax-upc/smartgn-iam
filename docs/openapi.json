    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "description": "Current IAM JWT. The service verifies the active session and operation-specific ownership, role and meter/function permissions. Roles: USER and SUPERADMIN.",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      },
      "serviceAuth": {
        "type": "http",
        "description": "Private service credential, independent of user JWTs. Internal routes must remain outside public gateway routing.",
        "scheme": "bearer"
      }
    }
  }
